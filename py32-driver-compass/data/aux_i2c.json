      "notes": [],
      "file": "py32f002b_hal_i2c.h",
      "kind": "macro",
      "src": "#define I2C_RISE_TIME(__FREQRANGE__, __SPEED__)            (((__SPEED__) <= 100000U) ? ((__FREQRANGE__) + 1U) : ((((__FREQRANGE__) * 300U) / 1000U) + 1U))"
    },
    {
      "name": "I2C_SPEED",
      "sig": "#define I2C_SPEED(__PCLK__, __SPEED__, __DUTYCYCLE__)      (((__SPEED__) <= 100000U)? (I2C_SPEED_STANDARD((__PCLK__), (__SPEED__))) : \\\n                                                                  ((I2C_SPEED_FAST((__PCLK__), (__SPEED__), (__DUTYCYCLE__)) & I2C_CCR_CCR) == 0U)? 1U : \\\n                                                                  ((I2C_SPEED_FAST((__PCLK__), (__SPEED__), (__DUTYCYCLE__))) | I2C_CCR_FS))",
      "brief": "组装 CCR 寄存器的完整配置值: 标准模式直接取 CCR 分频值, 快速模式在 CCR 非零时附加 FS 位。",
      "params": [
