      },
      "notes": [],
      "file": "py32f002b_hal_i2c.h",
      "kind": "macro",
      "src": "#define I2C_SPEED_STANDARD(__PCLK__, __SPEED__)            ((I2C_CCR_CALCULATION((__PCLK__), (__SPEED__), 2U) < 4U)? 4U:I2C_CCR_CALCULATION((__PCLK__), (__SPEED__), 2U))"
    },
