        "desc": "PCLK 低于所需最小频率返回 1, 否则返回 0"
      },
      "notes": [
        "HAL_I2C_Init 中用于校验 PCLK1 是否满足所选速率要求。"
      ],
      "file": "py32f002b_hal_i2c.h",
      "kind": "macro",
      "src": "#define I2C_MIN_PCLK_FREQ(__PCLK__, __SPEED__)             (((__SPEED__) <= 100000U) ? ((__PCLK__) < I2C_MIN_PCLK_FREQ_STANDARD) : ((__PCLK__) < I2C_MIN_PCLK_FREQ_FAST))"
    },
    {
      "name": "I2C_RISE_TIME",
      "sig": "#define I2C_RISE_TIME(__FREQRANGE__, __SPEED__)            (((__SPEED__) <= 100000U) ? ((__FREQRANGE__) + 1U) : ((((__FREQRANGE__) * 300U) / 1000U) + 1U))",
      "brief": "计算 TRISE 寄存器的上升时间值: 标准模式为 FREQRANGE+1, 快速模式按 FREQRANGE×300/1000+1 计算。",
      "params": [
