        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "快速模式 CCR 值(含 DUTY 位)"
      },
      "notes": [],
      "file": "py32f002b_hal_i2c.h",
      "kind": "macro",
      "src": "#define I2C_SPEED_FAST(__PCLK__, __SPEED__, __DUTYCYCLE__) (((__DUTYCYCLE__) == I2C_DUTYCYCLE_2)? I2C_CCR_CALCULATION((__PCLK__), (__SPEED__), 3U) : (I2C_CCR_CALCULATION((__PCLK__), (__SPEED__), 25U) | I2C_DUTYCYCLE_16_9))"
    },
    {
      "name": "I2C_SPEED_STANDARD",
      "sig": "#define I2C_SPEED_STANDARD(__PCLK__, __SPEED__)            ((I2C_CCR_CALCULATION((__PCLK__), (__SPEED__), 2U) < 4U)? 4U:I2C_CCR_CALCULATION((__PCLK__), (__SPEED__), 2U))",
      "brief": "计算标准模式下的 CCR 值, 计算结果小于 4 时钳位为 4, 满足规范对标准模式 CCR 的最小要求。",
