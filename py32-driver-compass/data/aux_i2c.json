          "type": "宏参数",
          "desc": "目标通信速率(Hz)"
        },
        {
          "name": "__COEFF__",
          "type": "宏参数",
          "desc": "分频系数: 标准模式为 2, 快速模式为 3 或 25"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "CCR 位段的分频值"
      },
      "notes": [],
      "file": "py32f002b_hal_i2c.h",
      "kind": "macro",
      "src": "#define I2C_CCR_CALCULATION(__PCLK__, __SPEED__, __COEFF__)     (((((__PCLK__) - 1U)/((__SPEED__) * (__COEFF__))) + 1U) & I2C_CCR_CCR)"
    },
