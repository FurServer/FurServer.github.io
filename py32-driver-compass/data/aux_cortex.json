    {
      "name": "__PKHBT",
      "sig": "#define __PKHBT(ARG1,ARG2,ARG3) \\\n({                          \\\n  uint32_t __RES, __ARG1 = (ARG1), __ARG2 = (ARG2); \\\n  __ASM (\"pkhbt %0, %1, %2, lsl %3\" : \"=r\" (__RES) :  \"r\" (__ARG1), \"r\" (__ARG2), \"I\" (ARG3)  ); \\\n  __RES; \\\n })",
      "brief": "CMSIS 内建 PKHBT 半字打包指令宏: 取 ARG1 的低半字与 ARG2 左移 ARG3 位后的高半字组合成一个 32 位值。",
      "params": [
        {
          "name": "ARG1",
          "type": "宏参数",
          "desc": "提供低半字的操作数"
        },
        {
          "name": "ARG2",
          "type": "宏参数",
          "desc": "提供高半字的操作数"
        },
        {
          "name": "ARG3",
          "type": "宏参数",
          "desc": "左移位数, 范围 0~31"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "组合后的 32 位结果"
      },
      "notes": [],
      "file": "cmsis_gcc.h",
      "kind": "macro",
      "src": "#define __PKHBT(ARG1,ARG2,ARG3) \\\r\n({                          \\\r\n  uint32_t __RES, __ARG1 = (ARG1), __ARG2 = (ARG2); \\\r\n  __ASM (\"pkhbt %0, %1, %2, lsl %3\" : \"=r\" (__RES) :  \"r\" (__ARG1), \"r\" (__ARG2), \"I\" (ARG3)  ); \\\r\n  __RES; \\\r\n })"
    },
    {
      "name": "__PKHTB",
      "sig": "#define __PKHTB(ARG1,ARG2,ARG3) \\\n({                          \\\n  uint32_t __RES, __ARG1 = (ARG1), __ARG2 = (ARG2); \\\n  if (ARG3 == 0) \\\n    __ASM (\"pkhtb %0, %1, %2\" : \"=r\" (__RES) :  \"r\" (__ARG1), \"r\" (__ARG2)  ); \\\n  else \\\n    __ASM (\"pkhtb %0, %1, %2, asr %3\" : \"=r\" (__RES) :  \"r\" (__ARG1), \"r\" (__ARG2), \"I\" (ARG3)  ); \\\n  __RES; \\\n })",
      "brief": "CMSIS 内建 PKHTB 半字打包指令宏: 取 ARG1 的高半字与 ARG2 算术右移 ARG3 位后的低半字组合成一个 32 位值, ARG3 为 0 时不移位。",
      "params": [
        {
          "name": "ARG1",
          "type": "宏参数",
          "desc": "提供高半字的操作数"
        },
        {
          "name": "ARG2",
          "type": "宏参数",
          "desc": "提供低半字的操作数"
        },
        {
          "name": "ARG3",
          "type": "宏参数",
          "desc": "算术右移位数, 范围 0~31"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "组合后的 32 位结果"
      },
      "notes": [],
      "file": "cmsis_gcc.h",
      "kind": "macro",
      "src": "#define __PKHTB(ARG1,ARG2,ARG3) \\\r\n({                          \\\r\n  uint32_t __RES, __ARG1 = (ARG1), __ARG2 = (ARG2); \\\r\n  if (ARG3 == 0) \\\r\n    __ASM (\"pkhtb %0, %1, %2\" : \"=r\" (__RES) :  \"r\" (__ARG1), \"r\" (__ARG2)  ); \\\r\n  else \\\r\n    __ASM (\"pkhtb %0, %1, %2, asr %3\" : \"=r\" (__RES) :  \"r\" (__ARG1), \"r\" (__ARG2), \"I\" (ARG3)  ); \\\r\n  __RES; \\\r\n })"
    },
