    {
      "name": "USART_BRR",
      "sig": "#define USART_BRR(_PCLK_, _BAUD_)      (((USART_DIVMANT((_PCLK_), (_BAUD_)) << 4U) + \\\n                                        ((USART_DIVFRAQ((_PCLK_), (_BAUD_)) & 0xF0U) << 1U)) + \\\n                                         (USART_DIVFRAQ((_PCLK_), (_BAUD_)) & 0x0FU))",
      "brief": "按采样率 16 计算并组合出写入 USART BRR 寄存器的波特率分频值 (整数部分左移 4 位, 与小数部分按 BRR 位域拼接)",
      "params": [
        {
          "name": "_PCLK_",
          "type": "宏参数",
          "desc": "USART 外设时钟频率 (PCLK)"
        },
        {
          "name": "_BAUD_",
          "type": "宏参数",
          "desc": "目标波特率"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "BRR 寄存器写入值 (波特率分频系数)"
      },
      "notes": [],
      "file": "py32f002b_hal_usart.h",
      "kind": "macro",
      "src": "#define USART_BRR(_PCLK_, _BAUD_)      (((USART_DIVMANT((_PCLK_), (_BAUD_)) << 4U) + \\\r\n                                        ((USART_DIVFRAQ((_PCLK_), (_BAUD_)) & 0xF0U) << 1U)) + \\\r\n                                         (USART_DIVFRAQ((_PCLK_), (_BAUD_)) & 0x0FU))"
    },
    {
      "name": "USART_DIV",
      "sig": "#define USART_DIV(_PCLK_, _BAUD_)      (((_PCLK_)*25U)/(4U*(_BAUD_)))",
      "brief": "按采样率 16 计算 USART 波特率分频系数并放大 100 倍, 公式为 (_PCLK_×25)/(4×_BAUD_), 等效于 (_PCLK_/(16×_BAUD_))×100",
      "params": [
        {
          "name": "_PCLK_",
          "type": "宏参数",
          "desc": "USART 外设时钟频率 (PCLK)"
        },
        {
          "name": "_BAUD_",
          "type": "宏参数",
          "desc": "目标波特率"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "放大 100 倍的波特率分频系数, 供 DIVMANT/DIVFRAQ 宏拆出整数与小数部分"
      },
      "notes": [],
      "file": "py32f002b_hal_usart.h",
      "kind": "macro",
      "src": "#define USART_DIV(_PCLK_, _BAUD_)      (((_PCLK_)*25U)/(4U*(_BAUD_)))"
    },
    {
      "name": "USART_DIVFRAQ",
      "sig": "#define USART_DIVFRAQ(_PCLK_, _BAUD_)  (((USART_DIV((_PCLK_), (_BAUD_)) - (USART_DIVMANT((_PCLK_), (_BAUD_)) * 100U)) * 16U + 50U) / 100U)",
      "brief": "按采样率 16 计算 USART 波特率分频的小数部分 (4 位小数, 含四舍五入)",
      "params": [
        {
          "name": "_PCLK_",
          "type": "宏参数",
          "desc": "USART 外设时钟频率 (PCLK)"
        },
        {
          "name": "_BAUD_",
          "type": "宏参数",
          "desc": "目标波特率"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "分频小数部分 (0~16, 对应 BRR 低 4 位小数位)"
      },
      "notes": [],
      "file": "py32f002b_hal_usart.h",
      "kind": "macro",
      "src": "#define USART_DIVFRAQ(_PCLK_, _BAUD_)  (((USART_DIV((_PCLK_), (_BAUD_)) - (USART_DIVMANT((_PCLK_), (_BAUD_)) * 100U)) * 16U + 50U) / 100U)"
    },
    {
      "name": "USART_DIVMANT",
      "sig": "#define USART_DIVMANT(_PCLK_, _BAUD_)  (USART_DIV((_PCLK_), (_BAUD_))/100U)",
      "brief": "按采样率 16 计算 USART 波特率分频的整数部分",
      "params": [
        {
          "name": "_PCLK_",
          "type": "宏参数",
          "desc": "USART 外设时钟频率 (PCLK)"
        },
        {
          "name": "_BAUD_",
          "type": "宏参数",
          "desc": "目标波特率"
        }
      ],
      "retval": {
        "type": "uint32_t",
        "desc": "分频整数部分 (对应 BRR 高 12 位)"
      },
      "notes": [],
      "file": "py32f002b_hal_usart.h",
      "kind": "macro",
      "src": "#define USART_DIVMANT(_PCLK_, _BAUD_)  (USART_DIV((_PCLK_), (_BAUD_))/100U)"
    }
